# ==============================================================================
# Letgetin Backend Environment Configuration
# ==============================================================================

PORT=5001
NODE_ENV=development

# Database Configuration (Local or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/letgetin

# Redis Configuration (Local or Upstash/Cloud Redis URI)
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets (Replace in production)
JWT_ACCESS_SECRET=super-secret-access-token-key-change-in-prod
JWT_REFRESH_SECRET=super-secret-refresh-token-key-change-in-prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URL for CORS
CLIENT_URL=http://localhost:3000

# Optional: Google AI Gemini API Key (Required for AI Resume analysis & embeddings)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: Email Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=LetGetIn <c2gupt@gmail.com>

# Optional: Google OAuth & Cloudinary
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
